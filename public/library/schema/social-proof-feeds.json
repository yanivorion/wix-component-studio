Color": {"type": "color", "default": "#FFFFFF", "label": "Card Background", "group": "Colors"}, "textColor": {"type": "color", "default": "#1A1A1A", "label": "Text", "group": "Colors"}, "mutedColor": {"type": "color", "default": "#6B6B6B", "label": "Muted Text", "group": "Colors"}, "starColor": {"type": "color", "default": "#C2803A", "label": "Stars", "group": "Colors"}, "borderColor": {"type": "color", "default": "#E3E1DB", "label": "Card Border", "group": "Colors"}, "headingSize": {"type": "number", "default": 34, "label": "Heading Size (px)", "group": "Typography"}, "quoteSize": {"type": "number", "default": 15, "label": "Review Size (px)", "group": "Typography"}}}, "Social.InstagramGrid": {"selector": ".instagram-grid", "displayName": "Instagram / UGC Grid", "archetype": "container", "props": {"sectionLabel": {"type": "text", "default": "Follow along", "label": "Section Label", "group": "Content"}, "heading": {"type": "text", "default": "Real work, posted daily", "label": "Heading", "group": "Content"}, "handle": {"type": "text", "default": "@northgate.studio", "label": "Handle", "group": "Content"}, "profileUrl": {"type": "text", "default": "https://instagram.com/", "label": "Profile URL", "group": "Content"}, "followLabel": {"type": "text", "default": "Follow", "label": "Follow Button", "group": "Content"}, "showFollow": {"type": "booleanValue", "default": true, "label": "Show Follow Button", "group": "Content"}, "posts": {"type": "text", "default": "https://images.unsplash.com/photo-1560066984-138dadb4c035?w=700&h=700&fit=crop|Balayage, four hours, worth every minute|482|24|;https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?w=700&h=700&fit=crop|Fresh fade for the weekend|311|9|;https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=700&h=700&fit=crop|Colour correction, before and after|1204|87|;https://images.unsplash.com/photo-1519699047748-de8e457a634e?w=700&h=700&fit=crop|Bridal trial season is here|657|31|;https://images.unsplash.com/photo-1595476108010-b4d1f102b1b1?w=700&h=700&fit=crop|New retail shelf, restocked|228|12|;https://images.unsplash.com/photo-1470259078422-826894b933aa?w=700&h=700&fit=crop|Sunday light in the studio|845|41|;https://images.unsplash.com/photo-1562322140-8baeececf3df?w=700&h=700&fit=crop|Cut and finish by Tom|392|18|;https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=700&h=700&fit=crop|Twelve years on this street|1583|104|", "label": "Posts (ImageURL|Caption|Likes|Comments|Link, separated by ;)", "group": "Content", "hint": "One post per ; — fields split by |. Leave Link blank for a non-clickable tile."}, "shoppableLabel": {"type": "text", "default": "Shop this", "label": "Shoppable Tag Text", "group": "Content", "hint": "Shown on tiles that have a Link"}, "showShoppable": {"type": "booleanValue", "default": false, "label": "Show Shoppable Tag", "group": "Content"}, "columns": {"type": "select", "default": "4", "label": "Columns", "group": "Layout", "options": ["2", "3", "4", "5", "6"]}, "rows": {"type": "select", "default": "2", "label": "Max Rows", "group": "Layout", "options": ["1", "2", "3", "all"]}, "gap": {"type": "select", "default": "8", "label": "Gap (px)", "group": "Layout", "options": ["0", "4", "8", "14", "22"]}, "tileRatio": {"type": "select", "default": "1/1", "label": "Tile Ratio", "group": "Layout", "options": ["1/1", "4/5", "3/4", "16/9"]}, "cornerRadius": {"type": "select", "default": "6", "label": "Corner Radius (px)", "group": "Layout", "options": ["0", "4", "6", "12", "20"]}, "hoverEffect": {"type": "select", "default": "caption", "label": "Hover Effect", "group": "Animation", "options": ["caption", "zoom", "engagement", "none"]}, "showEngagement": {"type": "booleanValue", "default": true, "label": "Show Likes & Comments", "group": "Animation"}, "backgroundColor": {"type": "color", "default": "#FFFFFF", "label": "Background", "group": "Colors"}, "textColor": {"type": "color", "default": "#1A1A1A", "label": "Text", "group": "Colors"}, "mut