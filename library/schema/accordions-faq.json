als, and regular training sessions. Our support team is always ready to assist you with any questions or challenges you may encounter.|||Q:Can I customize the solution?|A:Absolutely! Our platform is highly customizable to match your brand and workflow requirements. We work with you to configure features, integrations, and interfaces that align perfectly with your business processes.|||Q:What are the pricing options?|A:We offer flexible pricing plans to accommodate businesses of all sizes. From startups to enterprise clients, we have packages that scale with your growth. Contact us for a personalized quote based on your specific needs.", "label": "Question/Answer Pairs (Q:|A:|Q:|A:...)", "group": "Content", "hint": "Format: Q:question|A:answer|||Q:question|A:answer"}, "allowMultipleOpen": {"type": "booleanValue", "default": false, "label": "Allow Multiple Open", "group": "Content", "hint": "Allow multiple items to be open simultaneously"}, "defaultOpenIndex": {"type": "select", "default": "0", "label": "Default Open Item", "group": "Content", "options": ["none", "0", "1", "2", "3", "4"]}, "animationDuration": {"type": "select", "default": "400", "label": "Animation Duration (ms)", "group": "Animation", "options": ["300", "400", "500", "600"]}, "iconStyle": {"type": "select", "default": "chevron", "label": "Icon Style", "group": "Animation", "options": ["chevron", "plus", "arrow"]}, "maxWidth": {"type": "select", "default": "800px", "label": "Container Max Width", "group": "Layout", "options": ["700px", "800px", "900px", "1000px"]}, "itemGap": {"type": "select", "default": "1rem", "label": "Item Gap", "group": "Layout", "options": ["0.5rem", "0.75rem", "1rem", "1.5rem"]}, "headingFontSize": {"type": "number", "default": 14, "label": "Heading Font Size (px)", "group": "Typography"}, "questionFontSize": {"type": "number", "default": 17, "label": "Question Font Size (px)", "group": "Typography"}, "answerFontSize": {"type": "number", "default": 15, "label": "Answer Font Size (px)", "group": "Typography"}, "fontWeight": {"type": "select", "default": "500", "label": "Question Font Weight", "group": "Typography", "options": ["400", "500"]}, "backgroundColor": {"type": "color", "default": "#FFFFFF", "label": "Background Color", "group": "Colors"}, "headingColor": {"type": "color", "default": "#6C757D", "label": "Heading Color", "group": "Colors"}, "itemBackground": {"type": "color", "default": "#F8F9FA", "label": "Item Background", "group": "Colors"}, "itemBorder": {"type": "color", "default": "#E9ECEF", "label": "Item Border", "group": "Colors"}, "questionColor": {"type": "color", "default": "#212529", "label": "Question Color", "group": "Colors"}, "answerColor": {"type": "color", "default": "#495057", "label": "Answer Color", "group": "Colors"}, "iconColor": {"type": "color", "default": "#6C757D", "label": "Icon Color", "group": "Colors"}, "activeIconColor": {"type": "color", "default": "#212529", "label": "Active Icon Color", "group": "Colors"}}}, "Content.FAQAccordion": {"selector": ".faq-accordion", "displayName": "FAQ Accordion", "archetype": "container", "props": {"faqs": {"type": "text", "default": "What is your refund policy?|We offer a 30-day money-back guarantee. If you're not satisfied, contact our support team for a full refund.||How do I get started?|Simply sign up for an account, choose your plan, and follow our quick-start guide. You'll be up and running in minutes.||Do you offer customer support?|Yes! Our support team is available 24/7 via email, chat, and phone. We typically respond within 2 hours.||Can I upgrade or downgrade my plan?|Absolutely. You can change your plan anytime from your account settings. Changes take effect immediately.||Is my data secure?|Security is our top priority. We use bank-level encryption and comply with all major security standards including SOC 2 and GDPR.||Do you offer discounts for nonprofits?|Yes, we offer special pricing for qualified nonprofit organizations. Contact our sales team for details.", "label": "FAQs (format: question|answer, separated by ||)", "group": "Content"}, "showSearch": {"type": "booleanValue", "default": true, "label": "Show Search Filter", "group": "Content"}, "searchPlaceholder": {"type": "text", "default": "Search FAQs...", "label": "Search Placeholder", "group": "Content"}, "allowMultipleOpen": {"type": "booleanValue", "default": false, "label": "Allow Multiple Open", "group": "Content", "hint": "Allow multiple accordion items to be open simultaneously"}, "questionSize": {"type": "number", "default": 18, "label": "Question Font Size (px)", "group": "Typography"}, "answerSize": {"type": "number", "default": 16, "label": "Answer Font Size (px)", "group": "Typography"}, "fontWeight": {"type": "select", "default": "500", "label": "Question Font Weight", "group": "Typography", "options": ["300", "400", "500"]}, "backgroundColor": {"type": "color", "default": "#FFFFFF", "label": "Background Color", "group": "Colors"}, "itemBackground": {"type": "color", "default": "#F8F9FA", "label": "Item Background", "group": "Colors"}, "questionColor": {"type": "color", "default": "#212529", "label": "Question Text Color", "group": "Colors"}, "answerColor": {"type": "color", "default": "#495057", "label": "Answer Text Color", "group": "Colors"}, "borderColor": {"type": "color", "default": "#E9ECEF", "label": "Border Color", "group": "Colors"}, "iconColor": {"type": "color", "default": "#6C757D", "label": "Icon Color", "group": "Colors"}, "searchBorderColor": {"type": "color", "default": "#CED4DA", "label": "Search Border Color", "group": "Colors"}}}, "Accordion.FAQAdvanced": {"selector": ".faq-accordion-container", "displayName": "Advanced FAQ Accordion", "archetype": "container", "props": {"question1": {"type": "text", "default": "What makes your product unique?", "label": "Question 1", "group": "Content"}, "answer1": {"type": "text", "default": "Our product combines cutting-edge technology with intuitive design, offering a seamless experie